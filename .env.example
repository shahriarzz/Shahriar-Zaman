# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Firebase environment variable overrides (automatically loaded from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Optional Remote AI Coaching API Endpoint for Native Android Builds
# - Native APK/AAB builds require an explicitly configured, valid HTTPS URL (e.g., https://api.gainlog.app)
#   to communicate with the remote server-backed Gemini coaching endpoint.
# - If absent, malformed, or insecure, GAINLOG automatically activates the deterministic,
#   device-local progressive overload coaching fallback with no loss of user training capability.
# - IMPORTANT: Never bundle server API keys or secrets (such as GEMINI_API_KEY) into client VITE_* variables.
VITE_API_BASE_URL=
